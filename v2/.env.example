# ==============================================================================
# PS17 Multi-Agent Municipal Complaint Router — Environment Configuration
# Based on PS17 Master PRD Part 10
# ==============================================================================

ENVIRONMENT=development
APP_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:8000
CORS_ORIGINS=*

# ── LLM / Model Provider ───────────────────────────────────────────────────────
# Options: ollama (local testing) | gemini (final evaluation) | openai | local
LLM_PROVIDER=ollama

# Ollama Settings (Local Testing)
OLLAMA_BASE_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3

# Google Gemini Settings (Final Round Ready)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenAI Settings (Optional)
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ── Virtual Clock / Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
VIRTUAL_CLOCK_REDIS_KEY=virtual_time_offset_sec

# ── Statutory Governance Standards ───────────────────────────────────────────
MUNICIPAL_CORP=Pune Municipal Corporation (PMC)
RIGHT_TO_SERVICES_ACT=Maharashtra Right to Public Services Act 2015
