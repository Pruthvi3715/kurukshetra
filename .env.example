# ==============================================================================
# PS17 Multi-Agent Municipal Complaint Router — Environment Configuration
# ==============================================================================

ENVIRONMENT=production
APP_BASE_URL=https://kurkshetra.vercel.app
FRONTEND_BASE_URL=https://kurkshetra.vercel.app
CORS_ORIGINS=*

# ── LLM / Model Provider ───────────────────────────────────────────────────────
LLM_PROVIDER=gemini

# Google Gemini Settings (Gemini 2.5 Flash)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
